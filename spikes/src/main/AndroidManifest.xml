<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:label="muster spikes"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Driven over adb: am start -n dev.zacx.muster.spikes/.SpikeActivity -\-es cmd <cmd> -->
        <activity
            android:name=".SpikeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- S3/S4: the invisible step-up activity. Not exported: reachable only
             through the app's own PendingIntents. -->
        <activity
            android:name=".StepUpActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Spike.Invisible" />

        <!-- S3 control: a notification action delivered to a receiver, which
             then tries to start the step-up activity (the trampoline). -->
        <receiver
            android:name=".TrampolineReceiver"
            android:exported="false" />

        <!-- S12: edge-to-edge WebView. -->
        <activity
            android:name=".InsetsWebViewActivity"
            android:exported="true" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for at run time, right after pairing (API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Dictation: muster's page records through getUserMedia. RECORD_AUDIO
         is asked for at run time, when the page first asks (MicrophoneAccess).
         WebView's audio capture also needs MODIFY_AUDIO_SETTINGS (an
         install-time permission): without it WebView logs "Requires
         MODIFY_AUDIO_SETTINGS and RECORD_AUDIO", offers no recording device,
         and getUserMedia fails with NotReadableError even after the user
         allows the microphone (measured on an API 36 emulator). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Custom Tabs for links off the muster origin. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- allowBackup off: the device credential must never reach Auto Backup. -->
    <application
        android:name=".MusterApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- The launcher activity: server URL, the WebView shell, phone settings.
             configChanges: rotation, a window resize (multi-window, a
             foldable), display size (density), font size, dark mode and a
             keyboard never re-create it. Re-creating it destroyed the WebView
             and reloaded muster at its home page; now the live page keeps its
             place, scroll, input and connections, and the views (Compose and
             the WebView) adapt to the new configuration themselves. Anything
             not listed, and process death, still re-creates it: ShellRestore
             puts the shell back on the page it showed. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|fontWeightAdjustment|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- The UnifiedPush receiver. Not exported: the connector's own
             receiver (exported, from its manifest) hands it messages. -->
        <service
            android:name=".push.MusterPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>

        <!-- WorkManager initialises on demand (MusterApp is its
             Configuration.Provider), not at every process start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>

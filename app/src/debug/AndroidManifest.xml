<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY: lets adb run the background-refresh worker now
     (WorkManager will not run a periodic job before its period is up):
     adb shell am broadcast -n dev.zacx.muster/.RunRefreshReceiver

     It must be exported, because the broadcast comes from adb's shell user,
     not from this app. It requires android.permission.DUMP, which the shell
     user holds and an installed app cannot get (signature|privileged|development),
     so adb can send it and no other app on the phone can. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".RunRefreshReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
